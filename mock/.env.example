# 复制为 mock/.env 后填写。该文件只给 Node mock 服务读取，不会进入小程序产物。
PORT=3780
TOKEN_SECRET=replace-with-a-long-random-string
TOKEN_EXPIRES_IN=7200

# 小程序 AppID 可公开；AppSecret 绝不能出现在前端或 VITE_ 变量里。
WX_APPID=your-miniprogram-appid
WX_SECRET=your-miniprogram-secret

# true：对非开发 code 尝试调用微信 code2Session；失败则回落模拟会话。
WX_LIVE_LOGIN=true
