# ==============================================================================
# 元气善筑 UniApp - 环境变量示例
# ==============================================================================
#
# 本文件只作为配置模板，不会被 UniApp 编译器自动加载。
# 拉取项目后请根据目标环境复制一份，再修改复制后的文件：
#
#   本地开发：cp .env.example .env.development
#   生产构建：cp .env.example .env.production
#
# .env.development 用于 dev:h5 和 dev:mp-weixin；
# .env.production 用于 build:h5 和 build:mp-weixin。
# 修改环境文件后需要重新启动开发编译或重新执行生产构建。
#
# 安全提醒：VITE_ 变量会进入 H5 或小程序产物，任何用户都可能查看。
# 严禁填写数据库密码、微信 AppSecret、私钥或其他服务端秘密。
#

# 应用展示名称
# 平台正式名称、图标、版本号仍需在 manifest.json 中配置。
VITE_APP_TITLE=元气善筑
# 后端接口基础地址
# H5 开发可使用 /api（Vite 会代理到本地 mock:3780）；
# 微信开发者工具联调请改成完整地址，例如 http://127.0.0.1:3780，
# 并在开发者工具中勾选「不校验合法域名」。地址结尾不要添加 /。
# 生产环境填写 HTTPS 域名，并在微信后台配置 request 合法域名。
VITE_API_BASE_URL=/api

# 请求超时时间，单位为毫秒；10000 表示 10 秒。
VITE_API_TIMEOUT=10000

# 是否启用本地 Mock，可选值为 true / false。
# 开发环境可设为 true；生产环境必须修改为 false。
VITE_ENABLE_MOCK=true
